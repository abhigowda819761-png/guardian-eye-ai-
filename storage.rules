rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Meetings audio/video storage path: meetings/{userId}/{meetingId}.mp4
    match /meetings/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Recordings general storage path
    match /recordings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
