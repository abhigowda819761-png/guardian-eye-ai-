rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Meeting documents
    match /meetings/{meetingId} {
      // Allow read/write if the meeting belongs to the authenticated user or user is creator
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Meeting Transcripts collection
    // Users can only read and write their own meeting transcript logs
    match /transcripts/{transcriptId} {
      allow read: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if request.auth != null && 
        (request.resource.data.userId == request.auth.uid);
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }

    // Subcollections under meetings
    match /meetings/{meetingId}/transcripts/{transcriptDoc} {
      allow read, write: if request.auth != null;
    }
  }
}
